# EcoFlow AI backend configuration (copy to .env and fill in secrets)
DATABASE_URL=postgresql://ecoflow_user:ecoflow_password@localhost:5432/ecoflow
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
SECRET_KEY=change-me
ENVIRONMENT=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production overrides (optional)
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# ALLOWED_HOSTS=app.example.com,api.example.com
# RATE_LIMIT=60
# RATE_LIMIT_WINDOW=60
# REDIS_URL=redis://localhost:6379/0
# RETENTION_DAYS=365
# BACKUP_DIR=./backups
# BACKUP_RETENTION=7
# ADMIN_UIDS=firebase_uid_1,firebase_uid_2
